# Application
APP_ENV=development
APP_NAME=tiktok-posted-automator
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tiktok_automator

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PATH=./storage

# Google Drive (required from Phase 2+)
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_SOURCE_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=
DRIVE_POLL_INTERVAL_SECONDS=90
DRIVE_SETTLE_WINDOW_SECONDS=180
DRIVE_STABLE_CYCLES_REQUIRED=2

# TikTok (Phase 2+)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
TOKEN_REFRESH_THRESHOLD_SECONDS=1200

# Proxy provider (required from Phase 2+)
PROXY_PROVIDER_API_KEY=
PROXY_PROVIDER_BASE_URL=

# Telegram (required from Phase 5+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry (optional)
SENTRY_DSN=

# Admin panel (generate hash: python scripts/hash_admin_password.py yourpassword)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Proxy health
PROXY_HEALTH_CHECK_INTERVAL_SECONDS=600
STANDBY_PROXY_MIN_COUNT=1
